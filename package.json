{
  "name": "rca-agent",
  "version": "0.1.0",
  "description": "Root Cause Analysis Agent for Kotlin/Android Debugging",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:examples": "ts-node scripts/build-examples.ts",
    "build:all": "npm run build:examples && npm run build",
    "watch": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:accuracy": "ts-node scripts/run-accuracy-tests.ts",
    "test:golden": "RUN_GOLDEN_TESTS=true jest tests/golden",
    "test:phase1": "ts-node scripts/phase1-validation.ts",
    "test:phase1-quick": "ts-node scripts/test-phase1-quick.ts",
    "test:phase2": "ts-node scripts/test-phase2-validation.ts",
    "phase4:quickstart": "ts-node scripts/phase4-quickstart.ts",
    "phase4:day1": "echo 'Phase 4 Day 1: Test Infrastructure Setup' && npm run phase4:quickstart",
    "test:phase4:case1": "ts-node scripts/chunk7-test1-agp-retest.ts",
    "test:phase4:case6": "ts-node scripts/chunk8-test6-manifest.ts",
    "test:phase4:case7": "ts-node scripts/chunk8-test7-gradle-network.ts",
    "test:phase4:case8": "ts-node scripts/chunk8-test8-build-cache.ts",
    "test:phase4:case9": "ts-node scripts/chunk8-test9-proguard.ts",
    "test:phase4:case10": "ts-node scripts/chunk8-test10-navigation.ts",
    "test:phase4:existing": "npm run test:phase4:case1 && npm run test:phase4:case6 && npm run test:phase4:case7 && npm run test:phase4:case8 && npm run test:phase4:case9 && npm run test:phase4:case10",
    "test:phase4": "ts-node scripts/phase4-test-runner.ts",
    "test:phase4:all": "ts-node scripts/phase4-test-runner.ts",
    "populate:chromadb": "ts-node scripts/populate-chromadb.ts",
    "perf-test": "ts-node scripts/run-performance-tests.ts",
    "perf-test:quick": "ts-node scripts/run-performance-tests.ts -- --complexity simple",
    "perf-compare": "ts-node scripts/performance-comparison.ts",
    "perf-validate": "ts-node scripts/validate-setup.ts",
    "bench": "ts-node scripts/benchmark.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "debugging",
    "llm",
    "kotlin",
    "android",
    "rca"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.45.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@types/uuid": "^10.0.0",
    "chromadb": "^3.1.8",
    "node-fetch": "^3.3.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  }
}
