{
  "name": "rca-agent",
  "version": "2.0",
  "description": "Root Cause Analysis Agent for Kotlin/Android Debugging",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:accuracy": "ts-node scripts/run-accuracy-tests.ts",
    "test:golden": "RUN_GOLDEN_TESTS=true jest tests/golden",
    "test:all": "ts-node scripts/run-all-tests.ts",
    "test:phase1": "ts-node scripts/run-phase-tests.ts --phase 1",
    "test:phase2": "ts-node scripts/run-phase-tests.ts --phase 2",
    "test:phase4": "ts-node scripts/phase4-test-runner.ts",
    "test:phase4:optionc": "ts-node tests/real-world/run-option-c-tests.ts",
    "test:case": "ts-node scripts/run-all-tests.ts --tests",
    "test:diff": "ts-node scripts/test-diff-algorithm.ts",
    "test:minimal": "node scripts/test-fix-minimal.js",
    "validate:dataset": "ts-node scripts/test-dataset-validation.ts",
    "populate:chromadb": "ts-node scripts/populate-chromadb.ts",
    "perf-test": "ts-node scripts/run-performance-tests.ts",
    "perf-test:quick": "ts-node scripts/run-performance-tests.ts -- --complexity simple",
    "perf-compare": "ts-node scripts/performance-comparison.ts",
    "perf-validate": "ts-node scripts/validate-setup.ts",
    "bench": "ts-node scripts/benchmark.ts",
    "generate-stats": "ts-node scripts/generate-file-structure-stats.ts",
    "lint": "eslint \"src/**/*.ts\" --ignore-pattern \"**/*.d.ts\"",
    "format": "prettier --write src/**/*.ts",
    "secrets:scan": "ts-node scripts/scan-secrets.ts",
    "secrets:scan:staged": "ts-node scripts/scan-secrets.ts --cached",
    "_deprecated:phase1-old": "ts-node scripts/phase1-validation.ts",
    "_deprecated:phase1-quick": "ts-node scripts/test-phase1-quick.ts",
    "_deprecated:phase1-retest": "ts-node scripts/phase1-quick-retest.ts",
    "_deprecated:phase2-old": "ts-node scripts/test-phase2-validation.ts",
    "_deprecated:phase4-quickstart": "ts-node scripts/phase4-quickstart.ts",
    "_deprecated:chunk7": "ts-node scripts/chunk7-run-all-tests.ts",
    "_deprecated:chunk8": "ts-node scripts/chunk8-run-all-tests.ts",
    "_deprecated:chunk9": "ts-node scripts/chunk9-retest-all.ts",
    "_deprecated:test-case1": "ts-node scripts/chunk7-test1-agp-retest.ts",
    "_deprecated:test-case6": "ts-node scripts/chunk8-test6-manifest.ts",
    "_deprecated:test-case7": "ts-node scripts/chunk8-test7-gradle-network.ts",
    "_deprecated:test-case8": "ts-node scripts/chunk8-test8-build-cache.ts",
    "_deprecated:test-case9": "ts-node scripts/chunk8-test9-proguard.ts",
    "_deprecated:test-case10": "ts-node scripts/chunk8-test10-navigation.ts"
  },
  "keywords": [
    "debugging",
    "llm",
    "kotlin",
    "android",
    "rca"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.45.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.9",
    "@types/uuid": "^10.0.0",
    "chromadb": "^3.1.8",
    "node-fetch": "^3.3.0",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  }
}